# Copy to .env to change a default. Nothing here is required: SNAC's read
# commands need no key and no account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/snac-archives-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so the SNAC team
# can reach you if your use ever causes them trouble.
# SNAC_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# SNAC_CACHE_DIR=~/.cache/snac-archives-mcp

# Optional: HTTP timeout in seconds (default 60; holdings lists get 120).
# SNAC_TIMEOUT=60

# Optional: the API endpoint. Must be https.
# SNAC_API_URL=https://api.snaccooperative.org/
